al Balance ${balance}\n        </Typography>\n        <Typography\n          variant=\"subtitle1\"\n          style={{ lineHeight: \"1.5em\", marginTop: \"20px\" }}\n        >\n          <InfoCard />\n        </Typography>\n        <Divider className={classes.divider} />\n        <Form />\n      </CardContent>\n      <CardContent className={classes.cartContent}>\n        <Grid container spacing={2}>\n          <Grid item xs={12}>\n            <List />\n          </Grid>\n        </Grid>\n      </CardContent>\n    </Card>\n  );\n};\n\nexport default ExpenseTracker;\n","/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Snackbar/Snackbar.jsx",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Details/Details.jsx",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Details/styles.js",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/useTransactions.js",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Snackbar/styles.js",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/constants/categories.js",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Main/styles.js",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Main/Form/Form.jsx",["90"],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Main/List/List.jsx",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Main/Form/styles.js",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/components/Main/List/styles.js",[],"/Users/nikhil/Downloads/Voice_Powered_Expense_Tracker-main/src/utils/formatDate.js",["91"],"export default (date) => {\n  const d = new Date(date);\n  let month = `${d.getMonth() + 1}`;\n  let day = `${d.getDate()}`;\n  const year = d.getFullYear();\n\n  if (month.length < 2) {\n    month = `0${month}`;\n  }\n  if (day.length < 2) {\n    day = `0${day}`;\n  }\n\n  return [year, month, day].join(\"-\");\n};\n",{"ruleId":"92","replacedBy":"93"},{"ruleId":"94","replacedBy":"95"},{"ruleId":"96","severity":1,"message":"97","line":1,"column":17,"nodeType":"98","messageId":"99","endLine":1,"endColumn":25},{"ruleId":"96","severity":1,"message":"100","line":1,"column":27,"nodeType":"98","messageId":"99","endLine":1,"endColumn":36},{"ruleId":"96","severity":1,"message":"101","line":10,"column":10,"nodeType":"98","messageId":"99","endLine":10,"endColumn":26},{"ruleId":"96","severity":1,"message":"100","line":1,"column":47,"nodeType":"98","messageId":"99","endLine":1,"endColumn":56},{"ruleId":"102","severity":1,"message":"103","line":1,"column":1,"nodeType":"104","endLine":15,"endColumn":3},"no-native-reassign",["105"],"no-negated-in-lhs",["106"],"no-unused-vars","'useState' is defined but never used.","Identifier","unusedVar","'useEffect' is defined but never used.","'useSpeechContext' is defined but never used.","import/no-anonymous-default-export","Assign arrow function to a variable before exporting as module default","ExportDefaultDeclaration","no-global-assign","no-unsafe-negation"]